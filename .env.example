# Copy this file to .env and fill in the values. Never commit .env.
# "Required" means the bot won't start or a core feature breaks without it.

# --- Discord application ------------------------------------------------------
# From https://discord.com/developers/applications -> your app.
APP_ID=                 # Required. Application (client) ID.
PUBLIC_KEY=             # Required. Verifies requests on /interactions.
DISCORD_TOKEN=          # Required. Bot token, used for every Discord REST call.
AUTHSC=                 # OAuth2 client secret, for logging in to the /web admin site.

# --- Discord servers ----------------------------------------------------------
GUILD_ID=               # Required. ID of the main PSAF server.
WC_GUILD_ID=            # Required. ID of the World Cup server.

# --- MongoDB Atlas ------------------------------------------------------------
# The cluster host is hard-coded in config/mongoConfig.js; only the
# credentials come from here.
MONGU=                  # Required. MongoDB username.
MONGP=                  # Required. MongoDB password.

# --- HTTP / HTTPS -------------------------------------------------------------
# If both CERTKEY and CERT point to files that exist, the app runs in
# "online" (production) mode. Otherwise it runs in local mode (see docs/setup.md).
CERTKEY=                # Path to the TLS private key (production only).
CERT=                   # Path to the TLS certificate (production only).
PORT=                   # HTTP port in online mode (default 8080).
PORTHTTPS=              # HTTPS port in online mode (default 8443).
LOCALPORT=3000          # HTTP port in local mode (default 8080).

# --- Website sessions ---------------------------------------------------------
SESS_SC=                # Secret used to sign /site and /web session cookies.

# --- API keys -----------------------------------------------------------------
PSAF_API_KEY=           # Accepted on /api (x-api-key header); also sent to the PSAF site.
BRYLOS_API_KEY=         # Second key accepted on /api.
PSAFDB_API_KEY=         # Sent with player-picture uploads to the PSAF database.
STEAM_API_KEY=          # Steam Web API key, for Steam ID checks and name updates.

# --- Logging and alert webhooks -----------------------------------------------
WEBHOOK=                # Discord webhook for the transfer / contract / season log channel.
ERRORHOOK=              # Discord webhook for system errors (e.g. failed cron jobs).
CRASHESHOOK=            # Discord webhook that receives the crash report on the next start.
STEAMHOOK=              # Discord webhook for the daily Steam API usage report.
ERROR_LOG=psaferr.log   # File the crash handler writes to. Rotated into logs/.
STEAM_LOG=steam.log     # File every Steam API request is appended to. Rotated into logs/.

# --- Misc ---------------------------------------------------------------------
TZ=Europe/London        # Process time zone. Cron jobs always use Europe/London.
